{
  // Game source only. Scripts in scripts/ are run by bun directly.
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    // Migration phase: implicit any is an error, the rest of strict comes later.
    "strict": false,
    "noImplicitAny": true
  },
  "include": ["src"]
}
