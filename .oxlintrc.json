{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "oxlint-plugin-anti-slop" }],
  "ignorePatterns": ["original/**", "deob/**", "modes/**", "scripts/**", "docs/**", "shots/**", "**/dist/**"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "prefer-object-spread": "error",
    "unicorn/prefer-string-slice": "error",
    "oxc/no-accumulating-spread": "error",
    "no-bitwise": "warn",
    "typescript/no-non-null-assertion": "warn",

    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/require-readable-spacing": "off",
    // Tried: 6 hits, all Record<> annotations on small lookup tables (no real issue).
    "anti-slop/no-known-value-widening": "off",
    // Tried: 49 hits, all `Shape` (polygon/polyline) — the geometry domain term, not structure-naming.
    "anti-slop/no-shape-in-symbol-names": "off",
    // Tried: 0 hits; kept.
    "anti-slop/no-conditional-empty-object-spread": "error"
  },
  "overrides": [
    {
      // Playwright scripts: page.evaluate() callbacks introspect the live page through an untyped window
      // ((window as any).paperio2api ...); there is no invariant to state per assertion.
      "files": ["packages/e2e/src/**"],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": "off" }
    },
    {
      // The simulation must be bit-identical in every JS engine (golden hashes, client vs server). The spec lets
      // engines approximate these Math functions (JavaScriptCore and V8 differ in the last bit), so core uses
      // engine/trig.ts for sin/cos/atan2 and none of the others. sqrt, abs, floor, round, min, max... are exact.
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "sin", "message": "Use engine/trig.ts (bit-identical in every JS engine)." },
          { "object": "Math", "property": "cos", "message": "Use engine/trig.ts (bit-identical in every JS engine)." },
          {
            "object": "Math",
            "property": "tan",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "asin",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "acos",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "atan",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "atan2",
            "message": "Use engine/trig.ts (bit-identical in every JS engine)."
          },
          {
            "object": "Math",
            "property": "sinh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "cosh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "tanh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "asinh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "acosh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "atanh",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "exp",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "expm1",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "log",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "log1p",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "log2",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "log10",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "pow",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "cbrt",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          },
          {
            "object": "Math",
            "property": "hypot",
            "message": "Engine-dependent (spec allows approximation): the simulation must be bit-identical across JS engines."
          }
        ]
      }
    },
    {
      // Ports of C floating-point code: reading and writing IEEE-754 bit fields is the point.
      "files": [
        "packages/core/src/engine/trig.ts",
        "packages/core/test/trig-inputs.ts",
        "packages/e2e/test/trig-bit-exact.entry.ts"
      ],
      "rules": { "no-bitwise": "off" }
    }
  ]
}
