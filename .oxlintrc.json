{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "oxlint-plugin-anti-slop" }],
  "ignorePatterns": ["original/**", "deob/**", "modes/**", "scripts/**", "docs/**", "shots/**", "**/dist/**"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "prefer-object-spread": "error",
    "unicorn/prefer-string-slice": "error",
    "oxc/no-accumulating-spread": "error",
    "no-bitwise": "warn",
    "typescript/no-non-null-assertion": "warn",

    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/require-readable-spacing": "off",
    // Tried: 6 hits, all Record<> annotations on small lookup tables (no real issue).
    "anti-slop/no-known-value-widening": "off",
    // Tried: 49 hits, all `Shape` (polygon/polyline) — the geometry domain term, not structure-naming.
    "anti-slop/no-shape-in-symbol-names": "off",
    // Tried: 0 hits; kept.
    "anti-slop/no-conditional-empty-object-spread": "error"
  },
  "overrides": [
    {
      // Playwright scripts: page.evaluate() callbacks introspect the live page through an untyped window
      // ((window as any).paperio2api ...); there is no invariant to state per assertion.
      "files": ["packages/e2e/src/**"],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": "off" }
    },
    {
      // Ports of C floating-point code: reading and writing IEEE-754 bit fields is the point.
      "files": [
        "packages/core/src/engine/trig.ts",
        "packages/core/test/trig-inputs.ts",
        "packages/e2e/test/trig-bit-exact.entry.ts"
      ],
      "rules": { "no-bitwise": "off" }
    }
  ]
}
