{
  "name": "@paperio/client",
  "description": "Browser client: canvas renderer, Preact UI, input, skins artwork. Built to dist/site/ (bun run build).",
  "type": "module",
  "private": true,
  "dependencies": {
    "@paperio/core": "workspace:*",
    "@paperio/protocol": "workspace:*",
    "preact": "^11.0.0"
  },
  "scripts": {
    "build": "bun build.ts",
    "build:dev": "bun build.ts --dev",
    "dev": "bun build.ts --dev --watch",
    "typecheck": "tsgo --noEmit -p . && tsgo --noEmit -p tsconfig.build.json"
  }
}
