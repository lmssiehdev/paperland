{
  "name": "@paperio/client",
  "description": "Browser client: canvas renderer, Preact UI, input, skins artwork. Bundled to dist/app2.js.",
  "type": "module",
  "private": true,
  "dependencies": {
    "@paperio/core": "workspace:*",
    "@paperio/protocol": "workspace:*",
    "preact": "^11.0.0"
  },
  "scripts": {
    "build": "bun build src/main.ts --format=iife --define __DEV__=false --outfile dist/app2.js",
    "typecheck": "tsgo --noEmit -p .",
    "build:dev": "bun build src/main.ts --format=iife --define __DEV__=true --outfile dist/app2.js"
  }
}
