{
  "name": "@paperio/server",
  "description": "Bun + Elysia server: HTTP /api/*, WebSocket /play, headless game rooms (+ the client build at / when SITE_DIR is set). Compiles to one binary.",
  "type": "module",
  "private": true,
  "dependencies": {
    "@paperio/core": "workspace:*",
    "@paperio/protocol": "workspace:*",
    "elysia": "1.4.30"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "SITE_DIR=../client/dist/site bun --watch src/index.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --sourcemap --outfile dist/paperio-server",
    "typecheck": "tsgo --noEmit -p ."
  },
  "devDependencies": {
    "@elysiajs/eden": "1.4.9"
  }
}
