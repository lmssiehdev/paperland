# systemd unit for the compiled game server (deploy/deploy.sh installs it at /opt/paperio/paperio-server).
#   sudo cp deploy/paperio.service /etc/systemd/system/ && sudo systemctl enable --now paperio
#   journalctl -u paperio -f
[Unit]
Description=Paper.io game server (/api, /play WebSocket)
After=network.target

[Service]
ExecStart=/opt/paperio/paperio-server
# Only Caddy (same machine) talks to it.
Environment=HOST=127.0.0.1 PORT=3000
Restart=always
RestartSec=1
# SIGTERM -> rooms stop, server closes (src/index.ts).
KillSignal=SIGTERM
TimeoutStopSec=5

# The server reads nothing from disk and writes nothing: run it as a throwaway user with a read-only system.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# (No MemoryDenyWriteExecute: Bun's JIT needs writable+executable memory.)

[Install]
WantedBy=multi-user.target
